htmlcov/

# Offline basemap archives are release assets by default. Keep the tiny sample
# pack plus the bounded LandsD snapshots used by the three Hong Kong ALE cases.
*.mbtiles
!ale_aam_maptool/sample_scenario/basemaps/example.mbtiles
!ALE_v0.2/*/input/gis/basemaps/hong_kong_landsd.mbtiles

