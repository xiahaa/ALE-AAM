**/.venv/
__pycache__/
**/__pycache__/
.pytest_cache/
**/.pytest_cache/
.cache/
**/.cache/
*.py[cod]
*.egg-info/

# Runtime secrets (commit .env.example only)
.env
.env.local
*.secret.env
**/.env
**/.env.local
**/*.secret.env

