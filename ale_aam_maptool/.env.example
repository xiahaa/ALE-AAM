# Copy this file to .env. Never commit the populated .env file.
# auto prefers a scenario-local basemaps/*.mbtiles pack and otherwise uses scenario layers.
# hk-landsd-topographic selects the key-free live Hong Kong LandsD map when online.
ALE_AAM_BASEMAP=auto
ALE_AAM_TIANDITU_TOKEN=
ALE_AAM_MAPBOX_TOKEN=
ALE_AAM_MAPBOX_STYLE=mapbox/streets-v12
